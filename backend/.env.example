# Plantilla de variables de entorno del backend.
# Copia este archivo como .env y ajusta los valores. NUNCA subas el .env al repositorio.

# Entorno de ejecución
NODE_ENV=development

# Puerto del servidor (el proxy del frontend apunta al 3000)
PORT=3000

# Origen(es) del frontend permitido(s) por CORS, separados por coma
CORS_ORIGIN=http://localhost:5173

# Conexión a PostgreSQL (se usa desde T11 y T12). Reemplaza usuario, contraseña y base
DATABASE_URL="postgresql://USUARIO:CONTRASENA@localhost:5432/adel_dev?schema=public"

# Llave para firmar el token de sesión (se usa desde T22). Usa un valor largo y aleatorio en tu .env
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio